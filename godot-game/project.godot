; Engine configuration file.
; Godot 4.5 mobile garage. Phones use the Mobile renderer (clearcoat, one shadow
; map, a single reflection probe). Web export falls back to Compatibility.

config_version=5

[application]

config/name="Truck App"
config/description="Fictional truck garage for Omnipresent Games. The store is a test register."
run/main_scene="res://scenes/main.tscn"
boot_splash/bg_color=Color(0.047, 0.055, 0.071, 1)
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"
run/max_fps=60

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/dpi/allow_hidpi=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.047, 0.055, 0.071, 1)
reflections/reflection_atlas/reflection_size=256
reflections/reflection_atlas/reflection_count=4

[truck]

billing/provider="test"
